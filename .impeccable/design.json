  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main account action, with a clear hover and keyboard focus state.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Sign in</button>",
      "css": ".ds-button-primary{min-height:48px;border:1px solid var(--color-oxblood);border-radius:var(--radius-control);padding:11px 22px;color:var(--color-paper-light);background:var(--color-oxblood);font:700 0.9rem/1.25 var(--font-body);transition:background-color 140ms ease-out,border-color 140ms ease-out,color 140ms ease-out}.ds-button-primary:hover:not(:disabled){border-color:#5d1f27;background:#5d1f27}.ds-button-primary:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-button-primary:disabled{border-color:#62685f;color:#fffdf8;background:#62685f}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A lower emphasis account action, used for signing out.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Sign out</button>",
      "css": ".ds-button-secondary{min-height:48px;border:1px solid #606b60;border-radius:var(--radius-control);padding:11px 22px;color:var(--color-ink);background:transparent;font:700 0.9rem/1.25 var(--font-body);transition:background-color 140ms ease-out,border-color 140ms ease-out,color 140ms ease-out}.ds-button-secondary:hover:not(:disabled){border-color:var(--color-ink);color:var(--color-paper-light);background:var(--color-ink)}.ds-button-secondary:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-button-secondary:disabled{border-color:#62685f;color:#fffdf8;background:#62685f}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "A standard labeled email or password field with visible focus.",
      "html": "<label class=\"ds-field\" for=\"ds-email\">Email address</label><input class=\"ds-input\" id=\"ds-email\" type=\"email\" placeholder=\"\" />",
      "css": ".ds-field{display:block;margin-bottom:7px;color:#344138;font:700 0.82rem/1.4 var(--font-body)}.ds-input{display:block;width:100%;min-height:48px;border:1px solid #747c70;border-radius:var(--radius-control);padding:10px 13px;color:var(--color-ink);background:#fffdf8;font:400 1rem/1.5 var(--font-body)}.ds-input::placeholder{color:#5a625a;opacity:1}.ds-input:focus-visible{border-color:var(--color-focus);outline:3px solid var(--color-focus);outline-offset:2px}.ds-input:disabled{color:#424b42;background:#e9e5da}"
    },
    {
      "name": "Account Navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Compact sign-in and create-account links with a clear current route.",
      "html": "<nav class=\"ds-account-nav\" aria-label=\"Account access\"><a href=\"#sign-in\" aria-current=\"page\">Sign in</a><a href=\"#register\">Create account</a></nav>",
      "css": ".ds-account-nav{display:flex;align-items:center;gap:26px}.ds-account-nav a{padding:8px 0;border-bottom:2px solid transparent;color:var(--color-ink-soft);font:400 0.9rem/1.4 var(--font-body);text-decoration:none}.ds-account-nav a:hover{color:var(--color-oxblood);text-decoration:underline;text-underline-offset:4px}.ds-account-nav a[aria-current=page]{border-color:var(--color-oxblood);color:var(--color-ink);font-weight:700}.ds-account-nav a:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}"
    },
    {
      "name": "Auth Panel",
      "kind": "card",
      "refersTo": "auth-panel",
      "description": "The shared light-paper surface for the two equal account routes.",
      "html": "<section class=\"ds-auth-panel\"><h2>Sign in</h2><p>Open your player account.</p></section>",
      "css": ".ds-auth-panel{position:relative;min-width:0;background:var(--color-paper-light);box-shadow:var(--shadow-panel)}.ds-auth-panel:before{position:absolute;top:-1px;right:0;left:0;height:3px;background:var(--color-oxblood);content:''}"
    },
    {
      "name": "Journal Button",
      "kind": "button",
      "refersTo": "journal-button",
      "description": "Pressed-key action inside the camp journal; 44px minimum.",
      "html": "<button class=\"ds-j-btn\" type=\"button\">Save sheet</button>",
      "css": ".ds-j-btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;border:2px solid #571a22;border-radius:3px;padding:8px 18px;color:#fff4e0;background:#7a2932;box-shadow:0 3px 0 #571a22;font:700 .9rem/1.2 ui-sans-serif,system-ui,sans-serif;transition:transform 80ms ease,box-shadow 80ms ease,background-color 120ms ease}.ds-j-btn:hover{background:#571a22}.ds-j-btn:active{transform:translateY(2px);box-shadow:0 1px 0 #571a22}.ds-j-btn:focus-visible{outline:3px solid #1b5f8c;outline-offset:2px}"
    },
    {
      "name": "Journal Field",
      "kind": "input",
      "refersTo": "journal-input",
      "description": "Parchment text field with an uppercase label and 44px height.",
      "html": "<div class=\"ds-j-field\"><label for=\"ds-j-n\">Name <span>(required)</span></label><input id=\"ds-j-n\" class=\"ds-j-in\" value=\"Maren Vale\"></div>",
      "css": ".ds-j-field label{display:block;margin-bottom:6px;color:#2a1c13;font:700 .8rem/1.3 ui-sans-serif,system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase}.ds-j-field label span{color:#5a4535;font-weight:400;letter-spacing:0;text-transform:none}.ds-j-in{display:block;width:100%;min-height:44px;border:2px solid #6f5a45;border-radius:3px;padding:8px 10px;color:#2a1c13;background:#fbf5e4;box-shadow:inset 0 2px 0 rgb(90 60 30 / .12);font:400 1rem/1.4 ui-sans-serif,system-ui,sans-serif}.ds-j-in:focus-visible{outline:none;border-color:#1b5f8c}"
    },
    {
      "name": "Printed Plate",
      "kind": "card",
      "refersTo": "journal-page",
      "description": "Double-ruled parchment plate with a section title; the journal grouping primitive.",
      "html": "<section class=\"ds-plate\"><h3>Vitals</h3><p>Hit points 24 / 31</p></section>",
      "css": ".ds-plate{border:1px solid #6f5a45;border-radius:3px;padding:16px;color:#2a1c13;background:#f3e8cf;box-shadow:inset 0 0 0 3px #f3e8cf,inset 0 0 0 4px #b79f74}.ds-plate h3{margin:0 0 12px;padding-bottom:8px;border-bottom:2px solid #b79f74;font:700 .9rem/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase}.ds-plate p{margin:0;font:1rem/1.55 ui-sans-serif,system-ui,sans-serif;color:#5a4535}"
    },
